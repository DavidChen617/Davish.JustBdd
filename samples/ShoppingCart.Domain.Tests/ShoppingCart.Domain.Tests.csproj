<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AssemblyName>ShoppingCart.Domain.Tests</AssemblyName>
    <RootNamespace>ShoppingCart.Domain.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <Using Include="Xunit.Sdk" />
    <Using Include="Davish.JustBdd" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <ProjectReference Include="../ShoppingCart.Domain/ShoppingCart.Domain.csproj" />
    <ProjectReference Include="../../src/JustBdd.Xunit/JustBdd.Xunit.csproj" />
  </ItemGroup>
  <!-- Project references do not load the analyzers shipped in the package; reference them directly. -->
  <ItemGroup>
    <ProjectReference Include="../../src/JustBdd.Analyzers/JustBdd.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Project references do not import NuGet build assets automatically. -->
  <Import Project="../../src/JustBdd.Xunit/build/Davish.JustBdd.XunitV3.props" />
  <Import Project="../../src/JustBdd.Xunit/build/Davish.JustBdd.XunitV3.targets" />
</Project>
