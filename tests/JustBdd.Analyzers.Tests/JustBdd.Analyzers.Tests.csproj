<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AssemblyName>Davish.JustBdd.Analyzers.Tests</AssemblyName>
    <RootNamespace>Davish.JustBdd.Analyzers.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Match the analyzer's Roslyn version so tests run against the minimum supported compiler API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <!-- Analyzer.Testing pulls in Pkcs 9.0.6 through NuGet.Packaging (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); 9.0.21 is patched. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <ProjectReference Include="../../src/JustBdd.Analyzers/JustBdd.Analyzers.csproj" />
    <!-- Test sources compile against the real core API. -->
    <ProjectReference Include="../../src/JustBdd/JustBdd.csproj" />
  </ItemGroup>
</Project>
