<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>Davish.JustBdd</PackageId>
    <AssemblyName>Davish.JustBdd</AssemblyName>
    <RootNamespace>Davish.JustBdd</RootNamespace>
    <!-- Keep in step with Davish.JustBdd.XunitV3 and Davish.JustBdd.Tool; the release workflow checks all three against the tag. -->
    <Version>0.1.0-preview.1</Version>
    <Description>Given / When / Then scenarios as plain C# lambdas: a lazy step chain that records each step's description, source code, and result, with an analyzer that flags scenarios that never run.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build the analyzer first and ship it under analyzers/dotnet/cs. It is neither a runtime nor a package dependency. -->
    <ProjectReference Include="../JustBdd.Analyzers/JustBdd.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../JustBdd.Analyzers/bin/$(Configuration)/netstandard2.0/Davish.JustBdd.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
