<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>Davish.JustBdd.XunitV3</PackageId>
    <AssemblyName>Davish.JustBdd.XunitV3</AssemblyName>
    <RootNamespace>Davish.JustBdd</RootNamespace>
    <!-- Keep in step with Davish.JustBdd and Davish.JustBdd.Tool; the release workflow checks all three against the tag. -->
    <Version>0.1.0-preview.1</Version>
    <Description>xUnit v3 integration for Davish.JustBdd: xUnit assertions that chain after Then, and single-file HTML and CTRF reports written alongside xUnit's (--report-xunit-html, --report-xunit-ctrf). Requires xunit.v3 4.x.</Description>
    <NoWarn>$(NoWarn);TPEXP</NoWarn>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../JustBdd/JustBdd.csproj" />
  </ItemGroup>

  <Import Project="../JustBdd.Report/JustBdd.Report.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.4.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <PackageReference Include="xunit.v3.assert" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="build/Davish.JustBdd.XunitV3.props" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="build/Davish.JustBdd.XunitV3.targets" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Davish.JustBdd.XunitV3.Tests" />
  </ItemGroup>

</Project>
